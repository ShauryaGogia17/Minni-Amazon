# Local development only. Copy to .env; never commit .env.
POSTGRES_USER=shopai_bootstrap
POSTGRES_PASSWORD=change-local-bootstrap-password
PRODUCT_DB_USER=shopai_product
PRODUCT_DB_PASSWORD=change-local-product-password
AI_DB_USER=shopai_ai
AI_DB_PASSWORD=change-local-ai-password
REDIS_PASSWORD=change-local-redis-password
FRONTEND_PORT=5173
PRODUCT_PORT=8081
AI_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
# Native processes use these loopback addresses. Compose overrides container hosts.
PRODUCT_DB_URL=jdbc:postgresql://localhost:5432/shopai_product
AI_DATABASE_URL=postgresql://shopai_ai:change-local-ai-password@localhost:5432/shopai_ai
REDIS_HOST=localhost
REDIS_URL=redis://:change-local-redis-password@localhost:6379/1
PRODUCT_SERVICE_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:5173
SPRING_PROFILES_ACTIVE=dev
# Optional: enables model-assisted shopping intent extraction. Without it, catalog matching works.
# Server-side only. Never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
